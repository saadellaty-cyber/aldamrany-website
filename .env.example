# ---------------------------------------------------------------------------
# EL DAMARANY — environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Any PostgreSQL 14+ instance. For local development you can instead run
# `npm run db:start`, which boots an embedded PostgreSQL and prints this URL.
DATABASE_URL="postgresql://user:password@localhost:5432/eldamarany?schema=public"

# --- Application -----------------------------------------------------------
# Public origin, used for canonical URLs, sitemap, robots and Open Graph tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret used to sign session cookies and preview tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-64-character-random-hex-string"

# --- First administrator ---------------------------------------------------
# Consumed once by `npm run db:seed` / `npm run admin:create` to create the
# initial ADMIN user. No password is ever hardcoded in source.
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Site Administrator"

# --- Media storage ---------------------------------------------------------
# "local" writes uploads to LOCAL_STORAGE_DIR (development / single-server).
# "r2" uses Cloudflare R2 or any S3-compatible bucket (recommended for production).
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./var/uploads"

# Required when STORAGE_DRIVER="r2"
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="eldamarany-media"
# Public base URL that serves the bucket (custom domain or r2.dev subdomain).
R2_PUBLIC_URL="https://media.example.com"
R2_REGION="auto"

# Maximum accepted upload size in megabytes.
MAX_UPLOAD_MB="15"

# --- Outgoing mail ---------------------------------------------------------
# Emails a copy of every contact enquiry. Optional: leave these empty and the
# form still works — enquiries are stored and shown in the dashboard inbox,
# they just do not land in an inbox as well.
#
# The address they are sent TO is the contact email in Site Settings, so it is
# changed in the dashboard, not here.
#
# Send from a mailbox on your own domain, not from a free webmail account:
# the domain's SPF record authorises it, so the mail reaches the inbox instead
# of the spam folder. On Hostinger create the mailbox under Emails, then use:
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="noreply@eldamarany.com"
SMTP_PASSWORD=""
# Defaults to SMTP_USER. Most providers reject a From that is not the mailbox
# you authenticated as, so a display name is the only safe change:
#   SMTP_FROM="EL DAMARANY <noreply@eldamarany.com>"
SMTP_FROM=""
