# ---------------------------------------------------------------------------
# EL DAMARANY — environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Any PostgreSQL 14+ instance. For local development you can instead run
# `npm run db:start`, which boots an embedded PostgreSQL and prints this URL.
DATABASE_URL="postgresql://user:password@localhost:5432/eldamarany?schema=public"

# --- Application -----------------------------------------------------------
# Public origin, used for canonical URLs, sitemap, robots and Open Graph tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret used to sign session cookies and preview tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-64-character-random-hex-string"

# --- First administrator ---------------------------------------------------
# Consumed once by `npm run db:seed` / `npm run admin:create` to create the
# initial ADMIN user. No password is ever hardcoded in source.
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Site Administrator"

# --- Media storage ---------------------------------------------------------
# "local" writes uploads to LOCAL_STORAGE_DIR (development / single-server).
# "r2" uses Cloudflare R2 or any S3-compatible bucket (recommended for production).
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./var/uploads"

# Required when STORAGE_DRIVER="r2"
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="eldamarany-media"
# Public base URL that serves the bucket (custom domain or r2.dev subdomain).
R2_PUBLIC_URL="https://media.example.com"
R2_REGION="auto"

# Maximum accepted upload size in megabytes.
MAX_UPLOAD_MB="15"
