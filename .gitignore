# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local embedded postgres cluster
/.localdb/

# locally stored media uploads (STORAGE_DRIVER=local)
/var/

# generated prisma client
/src/generated/

# portable developer tooling downloaded locally (e.g. GitHub CLI)
/.tools/

# generated sheet of production values for pasting into the host's dashboard
/HOSTINGER-ENV.txt

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
